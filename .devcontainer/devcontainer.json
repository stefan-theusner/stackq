{
  "name": "stackq",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/stackq",
  "shutdownAction": "stopCompose",
  "remoteUser": "stackq",
  "containerUser": "stackq",
  "initializeCommand": "docker build -t stackq-app:dev -f .devcontainer/Dockerfile .",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "hverlin.mise-vscode",
        "ckolkman.vscode-postgres"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/stackq/.venv/bin/python"
      }
    }
  }
}
