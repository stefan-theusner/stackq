# --- stackq devcontainer: colors for every interactive bash (appended to /etc/bash.bashrc) ---
export TERM="${TERM:-xterm-256color}"
[ "$TERM" = "dumb" ] && export TERM=xterm-256color
export COLORTERM="${COLORTERM:-truecolor}"
export CLICOLOR=1

# Colored ls/grep
eval "$(dircolors -b)"
alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias grep='grep --color=auto'

# Colored prompt: user@stackq:dir (git-branch) $
__git_branch() { git branch --show-current 2>/dev/null | sed 's/.*/ (&)/'; }
PS1='\[\e[1;32m\]\u@stackq\[\e[0m\]:\[\e[1;34m\]\w\[\e[0;33m\]$(__git_branch)\[\e[0m\]\$ '
